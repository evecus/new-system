# Panther X2 (RK3566) 内核片段 — 基于 arm64 defconfig 叠加
# 用法:
#   make ARCH=arm64 defconfig
#   ./scripts/kconfig/merge_config.sh -m .config kernel-config/panther-x2.fragment
#   make ARCH=arm64 olddefconfig
# 参考基线: ophub kernel-config config-6.18 (只筛代理/路由/SBC 实际需要项)

# 明确关闭 NBD，避免因全内建被 olddefconfig 强制转成 =y
CONFIG_BLK_DEV_NBD=n

# --- 板级硬件 ---
# RK809 PMIC (供电树 + clkout1 提供 WiFi/BT 32.768K 时钟)
CONFIG_MFD_RK8XX=y
CONFIG_MFD_RK8XX_I2C=y
# 千兆网口 gmac1 (stmmac glue 层)
CONFIG_DWMAC_ROCKCHIP=y
# USB (dwc3 双角色;板上 usb_host0_xhci 为 host 模式)
CONFIG_USB_DWC3_DUAL_ROLE=y
# WiFi (brcmfmac SDIO;固件由 rootfs 提供)
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_SDIO=y
CONFIG_BRCMFMAC_USB=y

# --- tproxy 透明代理 (sing-box/mihomo,iptables 与 nftables 双栈) ---
CONFIG_NF_SOCKET_IPV4=m
CONFIG_NF_SOCKET_IPV6=m
CONFIG_NF_TPROXY_IPV4=m
CONFIG_NF_TPROXY_IPV6=m
CONFIG_NETFILTER_XT_MATCH_SOCKET=m
CONFIG_NETFILTER_XT_TARGET_TPROXY=m
CONFIG_NFT_SOCKET=m
CONFIG_NFT_TPROXY=m

# --- iptables (legacy xt) 常用项 ---
CONFIG_NF_NAT=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_MANGLE=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_IP_NF_TARGET_REDIRECT=m
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_IP6_NF_IPTABLES=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP6_NF_MANGLE=m
CONFIG_IP6_NF_NAT=m
CONFIG_NETFILTER_XT_NAT=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_TARGET_REDIRECT=m
CONFIG_NETFILTER_XT_TARGET_NETMAP=m
CONFIG_NETFILTER_XT_MATCH_STATE=m

# --- nftables 基础栈 (Debian 12 默认防火墙) ---
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_COMPAT=m
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_REJECT_INET=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
# DNS 劫持 redirect / 分流 fib 表达式 (nexa/sing-box/mihomo 必需)
CONFIG_NFT_REDIR=m
CONFIG_NFT_REDIR_IPV4=m
CONFIG_NFT_REDIR_IPV6=m
CONFIG_NFT_REDIR_INET=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_FIB_INET=m

# --- cgroup 分流 (v2) ---
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_NET_CLS_CGROUP=m

# --- 策略路由 (透明代理 fwmark 分流必需) ---
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IP_ROUTE_CLASSID=y

# --- ipset (老规则/批量地址表) ---
CONFIG_IP_SET=m
CONFIG_IP_SET_HASH_IP=m
CONFIG_IP_SET_HASH_NET=m
CONFIG_IP_SET_HASH_IPPORT=m
CONFIG_IP_SET_HASH_NETPORT=m
CONFIG_IP_SET_HASH_IPPORTNET=m
CONFIG_NETFILTER_XT_SET=m

# --- 诊断 (ss -t/-u/-x 需要) ---
CONFIG_INET_UDP_DIAG=m
CONFIG_UNIX_DIAG=m
CONFIG_PACKET_DIAG=m
CONFIG_NETLINK_DIAG=m

# --- zram/zswap (低内存 swap 压缩) ---
CONFIG_ZRAM=m
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZRAM_MULTI_COMP=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y

# --- 容器/虚拟网络模式 (docker macvlan/ipvlan/vxlan) ---
CONFIG_MACVLAN=m
CONFIG_MACVTAP=m
CONFIG_IPVLAN=m
CONFIG_IPVTAP=m
CONFIG_VXLAN=m

# --- SMB 服务器 (可选,不装 samba 服务可删) ---
CONFIG_KSMBD=m

# --- QoS 限速 (可选,不用 sqm 可删) ---
CONFIG_NET_SCH_CAKE=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_FQ=y

# --- BBR 拥塞控制 (99-bbr.conf 需要;defconfig 默认只有 cubic) ---
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y

# --- WireGuard / 常用防火墙 match (对齐 ophub 功能集) ---
CONFIG_WIREGUARD=y
CONFIG_CRYPTO_AES_ARM64_CE=y
CONFIG_CRYPTO_CHACHA20POLY1305=y
CONFIG_NETFILTER_XT_MATCH_CGROUP=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# --- THP 默认 madvise 模式 (choice 三选一,必须显式关 ALWAYS) ---
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=n

# --- 按需扩展: IPsec / IPVS / ebtables / KVM / NAS / 国密 / flow offload ---
# IPsec (strongswan/setkey 需要)
CONFIG_NET_KEY=y
CONFIG_XFRM_USER=y
CONFIG_INET_ESP=y
CONFIG_INET_ESP_OFFLOAD=y
CONFIG_INET6_ESP=y
CONFIG_INET6_ESP_OFFLOAD=y
# IPVS (LVS 负载均衡, k8s/swarm 场景)
CONFIG_IP_VS=y
CONFIG_IP_VS_IPV6=y
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_RR=y
CONFIG_IP_VS_WRR=y
CONFIG_IP_VS_LC=y
CONFIG_IP_VS_WLC=y
CONFIG_IP_VS_LBLC=y
CONFIG_IP_VS_DH=y
CONFIG_IP_VS_SH=y
CONFIG_IP_VS_SED=y
CONFIG_IP_VS_NQ=y
CONFIG_IP_VS_MH=y
# KVM (覆盖 slim 的 VIRTUALIZATION=n)
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
# NAS 客户端 (挂 NFS/SMB 共享)
CONFIG_NFS_FS=y
CONFIG_CIFS=y
# 国密硬件加速 (ARMv8.2 CE)
CONFIG_CRYPTO_SM3_ARM64_CE=y
CONFIG_CRYPTO_SM4_ARM64_CE=y
CONFIG_CRYPTO_SM4_ARM64_CE_BLK=y
CONFIG_CRYPTO_SM4_ARM64_CE_CCM=y
CONFIG_CRYPTO_SM4_ARM64_CE_GCM=y
# flow offload (NAT 加速;与 tproxy 共用时注意规则优先级,可整段删)
CONFIG_NF_FLOW_TABLE=y
CONFIG_NF_FLOW_TABLE_INET=y
CONFIG_NFT_FLOW_OFFLOAD=y
