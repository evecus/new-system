#!/bin/sh
# install-to-emmc — 把当前 TF 系统克隆到 eMMC (分区级克隆, 支持 TF 已扩容)
# 布局: GPT | 16MiB 引导间隙(u-boot) | BOOT ext4 512M | ROOTFS ext4 其余
set -e

# --- 定位源(当前根)与目标(另一颗 mmc) ---
SRC_ROOT=$(findmnt -no SOURCE /)
SRC_DISK=${SRC_ROOT%p[0-9]*}
case "$SRC_DISK" in
    /dev/mmcblk[0-9]) ;;
    *) echo "当前根不在 mmc 设备上($SRC_DISK), 仅支持 TF->eMMC 场景"; exit 1 ;;
esac
TGT=""
for d in /sys/block/mmcblk*; do
    dev="/dev/${d##*/}"
    case "$dev" in *boot*|*rpmb*) continue ;; esac
    [ "$dev" = "$SRC_DISK" ] && continue
    [ -b "$dev" ] && TGT="$dev" && break
done
[ -n "$TGT" ] || { echo "未找到目标 eMMC 设备"; exit 1; }

TGT_SIZE=$(lsblk -n -b -o SIZE "$TGT")
USED=$(du -sm / | awk '{print $1}')
if [ "$TGT_SIZE" -lt $(( USED * 1024 * 1024 )) ]; then
    echo "!! eMMC($TGT_SIZE 字节) 小于系统占用(${USED}MiB), 无法克隆"; exit 1
fi

echo "源  (TF  ): $SRC_DISK"
echo "目标(eMMC): $TGT"
echo "!!! 将整盘覆盖 $TGT , eMMC 上所有数据丢失 !!!"
printf "确认请输入 yes : "
read -r ans
[ "$ans" = "yes" ] || { echo "已取消"; exit 1; }

W=/tmp/e2m
rm -rf "$W" && mkdir -p "$W/boot" "$W/root"

echo "1/6 写入 u-boot (从源盘引导区复制)..."
dd if="$SRC_DISK" of="$TGT" conv=fsync,notrunc bs=512 skip=64    seek=64    count=16320 status=none
dd if="$SRC_DISK" of="$TGT" conv=fsync,notrunc bs=512 skip=16384 seek=16384 count=8192 status=none

echo "2/6 分区并格式化..."
parted -s "$TGT" mklabel gpt
parted -s "$TGT" mkpart BOOT ext4 16MiB 528MiB
parted -s "$TGT" mkpart ROOTFS ext4 528MiB 100%
partprobe "$TGT" 2>/dev/null || blockdev --rereadpt "$TGT" 2>/dev/null || true
sleep 1
mkfs.ext4 -F -q -L BOOT   -b 4096 -m 0 "${TGT}p1"
mkfs.ext4 -F -q -L ROOTFS -b 4096 -m 0 "${TGT}p2"

echo "3/6 克隆 /boot 与 / ..."
mount "${TGT}p1" "$W/boot"
mount "${TGT}p2" "$W/root"
rsync -aHAX /boot/ "$W/boot/"
rsync -aHAX \
    --exclude='/boot' --exclude='/dev' --exclude='/proc' --exclude='/sys' \
    --exclude='/run' --exclude='/tmp' --exclude='/swapfile' \
    --exclude="/$W" \
    / "$W/root/"
mkdir -p "$W/root/boot"

echo "4/6 修正 UUID 与引导配置..."
NEW_BOOT_UUID=$(lsblk -no UUID "${TGT}p1" | head -1)
NEW_ROOT_UUID=$(lsblk -no UUID "${TGT}p2" | head -1)
echo "UUID=${NEW_ROOT_UUID} / ext4 defaults,noatime 0 1" > "$W/root/etc/fstab"
echo "UUID=${NEW_BOOT_UUID} /boot ext4 defaults 0 2"     >> "$W/root/etc/fstab"
if [ -f "$W/boot/bootEnv.txt" ]; then
    sed -i "s|^rootdev=.*|rootdev=UUID=${NEW_ROOT_UUID}|g" "$W/boot/bootEnv.txt"
fi
if [ -f "$W/boot/extlinux/extlinux.conf" ]; then
    sed -i "s|root=UUID=[0-9a-f-]*|root=UUID=${NEW_ROOT_UUID}|g" "$W/boot/extlinux/extlinux.conf"
fi
# machine-id 让目标系统重新生成, marker 让其首启复核扩容
rm -f "$W/root/etc/machine-id" "$W/root/var/lib/dbus/machine-id" 2>/dev/null || true
rm -f "$W/root/var/lib/panther/resize-done" 2>/dev/null || true

echo "5/6 扩容目标 root 文件系统..."
resize2fs "${TGT}p2" || true

echo "6/6 同步..."
sync
umount "$W/boot" "$W/root"
sync

echo ""
echo "完成! 关机 -> 拔掉 TF 卡 -> 从 eMMC 启动"
echo "  poweroff"
